{
  "name": "coursepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-extension-zip.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-extension-zip.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:gemini": "tsx --conditions=react-server --env-file=.env.local scripts/test-gemini.ts",
    "e2e": "tsx --env-file=.env.local scripts/e2e-core-journey.ts",
    "test:assistant": "tsx --conditions=react-server --env-file=.env.local scripts/test-assistant.ts",
    "e2e:canvas": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-canvas-sync.ts",
    "test:website": "tsx --conditions=react-server --env-file=.env.local scripts/test-website.ts",
    "e2e:website": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-website.ts",
    "prod": "next build && next start",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
